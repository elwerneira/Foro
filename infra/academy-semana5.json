{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Sumativa semana 5 - Usuarios, Foro y Angular en Docker. No modifica Semana 4.",
  "Parameters": {
    "VpcId": {
      "Type": "AWS::EC2::VPC::Id"
    },
    "SubnetId": {
      "Type": "AWS::EC2::Subnet::Id"
    },
    "AllowedHttpCidr": {
      "Type": "String",
      "AllowedPattern": "\\d{1,3}(\\.\\d{1,3}){3}/32",
      "Description": "Solo la IPv4 publica autorizada para la demostracion, seguida de /32"
    },
    "InstanceProfile": {
      "Type": "String",
      "Default": "LabInstanceProfile"
    },
    "AmiId": {
      "Type": "AWS::SSM::Parameter::Value<AWS::EC2::Image::Id>",
      "Default": "/aws/service/ami-amazon-linux-latest/al2023-ami-kernel-default-x86_64"
    }
  },
  "Resources": {
    "PrivateBucket": {
      "Type": "AWS::S3::Bucket",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "BucketName": {
          "Fn::Sub": "fullstack3-foros-s5-${AWS::AccountId}"
        },
        "PublicAccessBlockConfiguration": {
          "BlockPublicAcls": true,
          "BlockPublicPolicy": true,
          "IgnorePublicAcls": true,
          "RestrictPublicBuckets": true
        },
        "BucketEncryption": {
          "ServerSideEncryptionConfiguration": [
            {
              "ServerSideEncryptionByDefault": {
                "SSEAlgorithm": "AES256"
              }
            }
          ]
        },
        "VersioningConfiguration": {
          "Status": "Enabled"
        }
      }
    },
    "PrivateBucketPolicy": {
      "Type": "AWS::S3::BucketPolicy",
      "Properties": {
        "Bucket": {
          "Ref": "PrivateBucket"
        },
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Deny",
              "Principal": "*",
              "Action": "s3:*",
              "Resource": [
                {
                  "Fn::Sub": "${PrivateBucket.Arn}"
                },
                {
                  "Fn::Sub": "${PrivateBucket.Arn}/*"
                }
              ],
              "Condition": {
                "Bool": {
                  "aws:SecureTransport": "false"
                }
              }
            }
          ]
        }
      }
    },
    "UsuariosOracleSecret": {
      "Type": "AWS::SecretsManager::Secret",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "Name": "fullstack3/semana5/usuarios-oracle",
        "Description": "Accesos Oracle de Usuarios para Semana 5",
        "SecretString": "{}"
      }
    },
    "ForoOracleSecret": {
      "Type": "AWS::SecretsManager::Secret",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "Name": "fullstack3/semana5/foro-oracle",
        "Description": "Accesos Oracle de Foro para Semana 5",
        "SecretString": "{}"
      }
    },
    "UsuariosImage": {
      "Type": "AWS::ECR::Repository",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "RepositoryName": "fullstack3-usuarios",
        "ImageTagMutability": "IMMUTABLE",
        "EncryptionConfiguration": {
          "EncryptionType": "AES256"
        }
      }
    },
    "ForoImage": {
      "Type": "AWS::ECR::Repository",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "RepositoryName": "fullstack3-foro",
        "ImageTagMutability": "IMMUTABLE",
        "EncryptionConfiguration": {
          "EncryptionType": "AES256"
        }
      }
    },
    "WebImage": {
      "Type": "AWS::ECR::Repository",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "RepositoryName": "fullstack3-foro-web",
        "ImageTagMutability": "IMMUTABLE",
        "EncryptionConfiguration": {
          "EncryptionType": "AES256"
        }
      }
    },
    "SecurityGroup": {
      "Type": "AWS::EC2::SecurityGroup",
      "Properties": {
        "VpcId": {
          "Ref": "VpcId"
        },
        "GroupDescription": "Solo HTTP desde la IP de demostracion; SSM sin SSH publico",
        "SecurityGroupIngress": [
          {
            "IpProtocol": "tcp",
            "FromPort": 80,
            "ToPort": 80,
            "CidrIp": {
              "Ref": "AllowedHttpCidr"
            }
          }
        ],
        "SecurityGroupEgress": [
          {
            "IpProtocol": "-1",
            "CidrIp": "0.0.0.0/0"
          }
        ],
        "Tags": [
          {
            "Key": "Name",
            "Value": "fullstack3-foros-s5"
          }
        ]
      }
    },
    "Instance": {
      "Type": "AWS::EC2::Instance",
      "Properties": {
        "ImageId": {
          "Ref": "AmiId"
        },
        "InstanceType": "t3.small",
        "IamInstanceProfile": {
          "Ref": "InstanceProfile"
        },
        "NetworkInterfaces": [
          {
            "DeviceIndex": "0",
            "AssociatePublicIpAddress": true,
            "SubnetId": {
              "Ref": "SubnetId"
            },
            "GroupSet": [
              {
                "Ref": "SecurityGroup"
              }
            ]
          }
        ],
        "MetadataOptions": {
          "HttpTokens": "required",
          "HttpEndpoint": "enabled"
        },
        "BlockDeviceMappings": [
          {
            "DeviceName": "/dev/xvda",
            "Ebs": {
              "VolumeSize": 12,
              "VolumeType": "gp3",
              "Encrypted": true,
              "DeleteOnTermination": true
            }
          }
        ],
        "UserData": {
          "Fn::Base64": "#!/bin/bash\nset -euo pipefail\ndnf install -y docker nginx unzip python3\nsystemctl enable --now docker amazon-ssm-agent\nmkdir -p /opt/foros-s5/private\nchmod 700 /opt/foros-s5/private\ndocker network inspect foros-s5 >/dev/null 2>&1 || docker network create foros-s5\nif ! command -v aws >/dev/null; then\n  curl -fsSL https://awscli.amazonaws.com/awscli-exe-linux-x86_64.zip -o /tmp/awscliv2.zip\n  unzip -q /tmp/awscliv2.zip -d /tmp/aws-cli-install\n  /tmp/aws-cli-install/aws/install\nfi\ncat > /etc/nginx/conf.d/foros-s5.conf <<'NGINX'\nserver {\n    listen 80 default_server;\n    server_name _;\n    server_tokens off;\n    location /api/usuarios/ {\n        proxy_pass http://127.0.0.1:8081/;\n        proxy_set_header Host $host;\n        proxy_set_header X-Real-IP $remote_addr;\n    }\n    location /api/foro/ {\n        proxy_pass http://127.0.0.1:8082/;\n        proxy_set_header Host $host;\n        proxy_set_header X-Real-IP $remote_addr;\n    }\n    location / {\n        proxy_pass http://127.0.0.1:4300;\n        proxy_set_header Host $host;\n    }\n}\nNGINX\n# Amazon Linux incluye un servidor predeterminado; usamos solo el del proyecto.\ncat > /etc/nginx/nginx.conf <<'NGINX'\nuser nginx;\nworker_processes auto;\nerror_log /var/log/nginx/error.log;\npid /run/nginx.pid;\nevents { worker_connections 1024; }\nhttp {\n    include /etc/nginx/mime.types;\n    default_type application/octet-stream;\n    access_log /var/log/nginx/access.log;\n    sendfile on;\n    include /etc/nginx/conf.d/*.conf;\n}\nNGINX\nnginx -t\nsystemctl enable --now nginx\ntouch /opt/foros-s5/bootstrap-completo\n"
        },
        "Tags": [
          {
            "Key": "Name",
            "Value": "fullstack3-foros-s5"
          }
        ]
      }
    }
  },
  "Outputs": {
    "InstanceId": {
      "Value": {
        "Ref": "Instance"
      }
    },
    "WebsiteUrl": {
      "Value": {
        "Fn::Sub": "http://${Instance.PublicIp}"
      }
    },
    "PrivateBucketName": {
      "Value": {
        "Ref": "PrivateBucket"
      }
    },
    "UsuariosSecretArn": {
      "Value": {
        "Ref": "UsuariosOracleSecret"
      }
    },
    "ForoSecretArn": {
      "Value": {
        "Ref": "ForoOracleSecret"
      }
    },
    "UsuariosImageUri": {
      "Value": {
        "Fn::GetAtt": [
          "UsuariosImage",
          "RepositoryUri"
        ]
      }
    },
    "ForoImageUri": {
      "Value": {
        "Fn::GetAtt": [
          "ForoImage",
          "RepositoryUri"
        ]
      }
    },
    "WebImageUri": {
      "Value": {
        "Fn::GetAtt": [
          "WebImage",
          "RepositoryUri"
        ]
      }
    }
  }
}
