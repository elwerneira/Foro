            }
          ]
        },
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/categorias",
        "description": "Ejecutar en orden. Solo modificar los registros temporales creados por esta colección.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"Prueba video S5 {{marca}}\",\n  \"descripcion\": \"Categoría temporal de demostración\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "for (const k of [\"categoriaId\", \"temaId\", \"comentarioId\"]) pm.collectionVariables.unset(k);",
              "pm.collectionVariables.set(\"marca\", String(Date.now()));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
              "if (pm.response.code === 201) {",
              "  const id = pm.response.json().id;",
              "  pm.test(\"ID generado válido\", () => pm.expect(id).to.be.a(\"number\").and.above(0));",
              "  if (Number.isInteger(id) && id > 0) pm.collectionVariables.set(\"categoriaId\", String(id));",
              "}"
            ]
          }
        }
      ]
    },
